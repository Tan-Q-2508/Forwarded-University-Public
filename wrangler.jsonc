{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forwarded-university",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-07",
  "upload_source_maps": true,
  // Static frontend (free, unlimited). Only /api/* and /ws/* wake the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // One SQLite-backed Durable Object class, one instance per 4-letter room code.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" }
  },
  // The content bank. Create it once with `npx wrangler d1 create forwarded-university`, paste the printed
  // database_id below, then `npm run db:migrate:remote` and `npm run import:remote`. The id below is a LOCAL-ONLY
  // placeholder (wrangler dev creates the local database automatically); `wrangler deploy` needs the real id.
  "d1_databases": [
    { "binding": "DB", "database_name": "forwarded-university", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // "1" only in local dev (npm run dev:worker): lets a whole game run on synthetic TEST content.
  "vars": { "DEV_CONTENT": "0", "ALLOW_TEST_CONTENT": "0" }
}
